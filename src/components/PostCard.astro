---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatDate, isoDate } from "../utils/date";

interface Props {
  href: string;
  image?: ImageMetadata;
  date: Date;
  category: string;
  title: string;
}

const { href, image, date, category, title } = Astro.props;
---

<li class="post-card">
  <a class="post-card__link" href={href}>
    <div class="post-card__thumb">
      {image && <Image src={image} alt="" width={640} format="webp" />}
    </div>
    <div class="post-card__body">
      <div class="post-card__meta">
        <time class="post-card__date" datetime={isoDate(date)}>{formatDate(date)}</time>
        <span class="post-card__cat">{category}</span>
      </div>
      <h3 class="post-card__title">{title}</h3>
    </div>
  </a>
</li>
