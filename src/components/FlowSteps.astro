---
const steps = [
  {
    title: "お問い合わせ",
    text: "お電話、またはお問い合わせフォームよりご連絡ください。修理箇所の写真をお送りいただくとスムーズです。",
  },
  {
    title: "お見積り・日程調整",
    text: "写真をもとに損傷状態を確認し、概算のお見積りと日程を調整します。出張先の作業スペースや電源等も確認します。",
  },
  {
    title: "修理（出張・ご来店）",
    text: "現物を確認のうえ、その場で修理します。ご来店での修理も承ります。",
  },
  {
    title: "仕上がり確認・お引渡し",
    text: "仕上がりをご確認いただき、お引渡しとなります。",
  },
];
---

<ol class="flow">
  {
    steps.map((step, i) => (
      <li class="flow__item">
        <span class="flow__num">{i + 1}</span>
        <h3 class="flow__title">{step.title}</h3>
        <p class="flow__text">{step.text}</p>
      </li>
    ))
  }
</ol>