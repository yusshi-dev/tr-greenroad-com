---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  image: ImageMetadata;
  title: string;
  summary: string;
}

const { href, image, title, summary } = Astro.props;
---

<div class="svcrow">
  <div class="svcrow__media"><Image src={image} alt={title} width={900} format="webp" /></div>
  <div class="svcrow__body">
    <h3 class="svcrow__title">{title}</h3>
    <p>{summary}</p>
    <a class="svcrow__link" href={href}>詳細を見る</a>
  </div>
</div>
