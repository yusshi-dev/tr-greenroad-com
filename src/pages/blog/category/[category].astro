---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import BlogList from "../../../components/BlogList.astro";
import { categoryPath, getCategories, getSortedPosts, paginate } from "../../../utils/blog";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return getCategories(posts).map((category) => ({ params: { category: category.name } }));
}

const name = Astro.params.category!;
const all = await getSortedPosts();
const categories = getCategories(all);
const filtered = all.filter((post) => post.data.category === name);
const { items, page, totalPages } = paginate(filtered, 1);
---

<BaseLayout title={`${name}の施工事例`}>
  <SiteHeader
    current="blog"
    hero={{ variant: "page", image: "/img/hero-blog.webp", title: "ブログ（施工事例）" }}
  />

  <main>
    <section class="section">
      <div class="section__inner" style="padding-top:64px;padding-bottom:0">
        <BlogList
          posts={items}
          categories={categories}
          currentCategory={name}
          page={page}
          totalPages={totalPages}
          basePath={categoryPath(name)}
        />
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
