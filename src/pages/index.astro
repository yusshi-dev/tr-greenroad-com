---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NoticeBar from "../components/NoticeBar.astro";
import ServiceRow from "../components/ServiceRow.astro";
import PostCard from "../components/PostCard.astro";
import FlowSteps from "../components/FlowSteps.astro";
import ContactSection from "../components/ContactSection.astro";
import { getEyecatch, postPath } from "../utils/blog";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.published_at.valueOf() - a.data.published_at.valueOf(),
);
const news = (await getCollection("news")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const latestNews = news[0];
const recentPosts = posts.slice(0, 3);
---

<BaseLayout>
  <SiteHeader current="home" hero={{ variant: "home", image: "/img/hero-wheel.webp" }} />

  <main>
    {
      latestNews && (
        <NoticeBar
          href={`/news/${latestNews.id}/`}
          date={latestNews.data.date}
          label={latestNews.data.label}
          title={latestNews.data.title}
        />
      )
    }

    <section class="section">
      <div class="section__inner">
        <h2 class="section__title">サービス</h2>
        <div class="svc-list">
          {
            services.map((service) => (
              <ServiceRow
                href={`/service/${service.id}/`}
                image={service.data.image}
                title={service.data.title}
                summary={service.data.summary}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section__inner">
        <h2 class="section__title">ブログ（施工事例）</h2>
        <ul class="post-grid">
          {
            recentPosts.map((post) => (
              <PostCard
                href={postPath(post)}
                image={getEyecatch(post)}
                date={post.data.published_at}
                category={post.data.category}
                title={post.data.title}
              />
            ))
          }
        </ul>
        <p class="more-link"><a href="/blog/">ブログ一覧を見る</a></p>
      </div>
    </section>

    <section class="section">
      <div class="section__inner">
        <h2 class="section__title">ご利用の流れ</h2>
        <FlowSteps />
      </div>
    </section>

    <ContactSection />
  </main>

  <SiteFooter flush />
</BaseLayout>
